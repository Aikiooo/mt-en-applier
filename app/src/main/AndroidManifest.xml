<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shizuku API permission: the server checks for this before delivering the
         binder to our provider. Required (same as Mihon/MacroDroid declare). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Download the latest patch + translation cache from GitHub Releases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "Uninstall this app" button: since targetSdk 28 the system silently ignores
         ACTION_DELETE from apps that don't declare this (install-time, no prompt). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- No storage permission needed: we read __data from our own app-specific
         external dir (getExternalFilesDir) and write via Shizuku (shell uid). -->

    <!-- Android 11+ package visibility: let us see the Shizuku app/server so the
         API can locate its provider and handshake the binder. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- "Launch game" button after a successful install -->
        <package android:name="jp.gree_ent.mushoku" />
        <provider android:authorities="moe.shizuku.privileged.api.shizuku" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Shizuku provider discovery -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
